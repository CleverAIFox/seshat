# seshat 로컬 환경변수 템플릿(DECISIONS §21 · MASTER §11)
#
# 이 파일은 커밋한다. 값을 채운 .env 는 커밋하지 않는다.
#   cp .env.example .env
# ★ 셸이 이긴다. `.env` 는 기본값이고 `export` 는 한 번만 덮는 판단이다(seshat/paths.py).
# ★ 드라이브 문자는 기계마다 다르다. 남의 값을 복사하지 않는다.

# 데이터 레이크 — SSD 위의 원본 · 실험 결과 · 캐시. 심링크는 쓰지 않는다.
#   thoth 는 /mnt/f/projects/thoth 를 쓴다. 옆자리에 둔다.
#   처음 한 번: python3 tools/lake.py init
SESHAT_DATA=
# 브라우저 다운로드 폴더. 패치가 여기로 온다(tools/apply_patch.sh). thoth 의 WIN_DOWNLOADS 와 같은 곳이다
SESHAT_INBOX=

# AWS Translate 기준선(H-025)을 잴 때만 쓴다. 번역 호출은 과금이다 — 100만 자에 USD 15
#   리전을 짐작하지 않는다. 없으면 도구가 멈춘다(DECISIONS §36)
AWS_REGION=ap-northeast-2
# 프로필 이름. 키는 여기 적지 않는다 — ~/.aws 가 든다
AWS_PROFILE=

# FLORES+ 범용 평가셋을 받을 때만 쓴다(tools/fetch_flores.py · H-035)
#   1. huggingface.co → Settings → Access Tokens → Create new token(Read)
#   2. **동의가 필요한 데이터셋이다.** openlanguagedata/flores_plus 페이지에서 Agree 를 누른다.
#      안 누르면 토큰이 멀쩡해도 막힌다
#   토큰은 비밀이다. 이 파일(.env.example)이 아니라 .env 에만 적는다
HF_TOKEN=
